# ==========================================
# E-LEARNING PLATFORM BACKEND CONFIGURATION
# ==========================================

# Server Environment
NODE_ENV=production
PORT=5000

# Database
MONGO_URI=mongodb://localhost:27017/elearning_platform

# Client URL (for CORS & Webhook redirects)
CLIENT_URL=http://localhost:5173

# Authentication & JWT Secrets
JWT_SECRET=your_super_secret_jwt_access_key_min_32_chars
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_SECRET=your_super_secret_jwt_refresh_key_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=150

# Payment Gateways (Optional / Sandbox defaults)
PAYMENT_DEFAULT_PROVIDER=SANDBOX
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
