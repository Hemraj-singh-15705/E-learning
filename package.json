{
  "name": "elearning-platform-root",
  "version": "1.0.0",
  "description": "Root configuration for MERN Mentorship & EdTech Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "install:all": "npm install && npm run install:server && npm run install:client",
    "install:server": "npm --prefix server install",
    "install:client": "npm --prefix client install",
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "build:server": "npm --prefix server run build",
    "build:client": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
